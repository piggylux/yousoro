# ID of your AniList API client, from https://anilist.co/settings/developer.
# Set its redirect URL to <site origin>/auth/anilist/callback,
# e.g. http://localhost:5173/auth/anilist/callback for local development.
# The ID isn't secret; it is sent to the browser.
ANILIST_CLIENT_ID=

# Optional: a MyAnimeList API client, from https://myanimelist.net/apiconfig, of the "web" type.
# Set its redirect URL to <site origin>/auth/myanimelist/callback,
# e.g. http://localhost:5173/auth/myanimelist/callback for local development.
# Leave both empty to switch MyAnimeList off. Keep the secret private.
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=
